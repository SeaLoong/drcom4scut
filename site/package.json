{
  "name": "drcom4scut-website",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:docs": "node scripts/prepare.mjs",
    "dev": "npm run prepare:docs && vitepress dev . --host 127.0.0.1",
    "build": "npm test && npm run prepare:docs && vitepress build . && python3 scripts/check-links.py",
    "preview": "vitepress preview . --host 127.0.0.1",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "@playwright/test": "1.64.1"
  },
  "overrides": {
    "vite": "6.4.5"
  }
}
